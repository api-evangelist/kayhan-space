            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve BPlane Data for CDM by CDM ID."
        },
