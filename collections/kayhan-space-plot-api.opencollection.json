              "accessTokenUrl": "oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get dilution region max pc curves"
        },
        {
          "info": {
            "name": "Get Conjunction Message Bplane By Id",
            "type": "http"
