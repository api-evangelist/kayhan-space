{
  "opencollection": "1.0.0",
  "info": {
    "name": "Satcat Service Authentication Events API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Event Cdms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/satcat/events/:event_key/cdms",
            "params": [
              {
                "name": "event_key",
                "value": "",
                "type": "path",
                "description": "key of the event"
              },
              {
                "name": "operational",
                "value": "",
                "type": "query",
                "description": "Whether to include only CDMs with designation 'OPERATIONAL' in the result; defaults to true"
              },
              {
                "name": "filters",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "count",
                "value": "",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List the CDMs in the event."
        },
        {
          "info": {
            "name": "List Event Latest Cdms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/satcat/events/:event_key/latest_cdms",
            "params": [
              {
                "name": "event_key",
                "value": "",
                "type": "path",
                "description": "key of the event"
              },
              {
                "name": "operational",
                "value": "",
                "type": "query",
                "description": "Whether to include only CDMs with designation 'OPERATIONAL' in the result; defaults to true"
              },
              {
                "name": "filters",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "count",
                "value": "",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List the CDMs in the event."
        }
      ]
    }
  ],
  "bundled": true
}